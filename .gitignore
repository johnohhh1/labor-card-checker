# Allowlist: only source files are published. Labor-card PDFs, rosters,
# exports and test reports contain employee data and must never be committed.
/*
!/.gitignore
!/README.md
!/LICENSE
!/local/
!/web/
!/extension/

*.pdf
*.png
!/extension/notification.png
*.log
*.csv
*.xlsx
local/fixtures/
__pycache__/

# web: dependencies and build output (recreated by npm ci / node build.mjs)
web/node_modules/
web/.wrangler/
web/public/runtime/
web/public/vendor/
web/public/wheels/
web/public/analyzer.py
web/public/app.js
web/public/index.html
web/public/style.css
web/public/wheels.json
web/browser-test-results.json

# Secrets: never commit env files (keep the example template)
.env
.env.*
*.env
*.env.txt
.env.txt
.dev.vars
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
credentials*.json
client_secret*.json
